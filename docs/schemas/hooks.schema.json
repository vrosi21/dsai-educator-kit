{
  "$defs": {
    "HookSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Unique in the whole course, and permanent.",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "for": {
          "description": "What the hook brings back.",
          "maxLength": 200,
          "minLength": 1,
          "title": "For",
          "type": "string"
        },
        "kind": {
          "default": "phrase",
          "description": "The technique, shown as a label.",
          "enum": [
            "phrase",
            "acronym",
            "image",
            "story",
            "rhyme",
            "peg"
          ],
          "title": "Kind",
          "type": "string"
        },
        "hook": {
          "description": "The mnemonic itself.",
          "title": "Hook",
          "type": "string"
        },
        "explain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the hook maps onto the real thing.",
          "title": "Explain"
        },
        "topic": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "`id` of a topic declared in course.yaml.",
          "title": "Topic"
        },
        "refs": {
          "description": "Links to other content, e.g. `card:fisher-01`, `lecture:05-features`.",
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "for",
        "hook"
      ],
      "title": "HookSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Mnemonics that are not tied to one flashcard. (A `hook` written on a card appears on\nthe Memory page as well; do not repeat it here.)",
  "properties": {
    "hooks": {
      "items": {
        "$ref": "#/$defs/HookSpec"
      },
      "minItems": 1,
      "title": "Hooks",
      "type": "array"
    }
  },
  "required": [
    "hooks"
  ],
  "title": "HooksFile",
  "type": "object"
}
